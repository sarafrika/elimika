{
  "realm": "elimika-local",
  "enabled": true,
  "displayName": "Elimika (local)",
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 36000,
  "ssoSessionMaxLifespan": 36000,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "client": {
      "elimika-backend": [
        {
          "name": "admin",
          "description": "Mirrors the app's admin user domain (the app authorises from its own DB)",
          "clientRole": true
        },
        {
          "name": "organisation_user",
          "description": "Mirrors the app's organisation_user user domain (the app authorises from its own DB)",
          "clientRole": true
        },
        {
          "name": "instructor",
          "description": "Mirrors the app's instructor user domain (the app authorises from its own DB)",
          "clientRole": true
        },
        {
          "name": "course_creator",
          "description": "Mirrors the app's course_creator user domain (the app authorises from its own DB)",
          "clientRole": true
        },
        {
          "name": "student",
          "description": "Mirrors the app's student user domain (the app authorises from its own DB)",
          "clientRole": true
        },
        {
          "name": "parent",
          "description": "Mirrors the app's parent user domain (the app authorises from its own DB)",
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "elimika-backend",
      "name": "Elimika API (admin client)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "elimika-local-backend-secret",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": false,
      "fullScopeAllowed": true
    },
    {
      "clientId": "elimika-ui",
      "name": "Elimika UI (local)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "elimika-local-ui-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*",
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "elimika-backend client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "elimika-backend",
            "claim.name": "resource_access.elimika-backend.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "user_domain",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "user_domain",
            "claim.name": "user_domain",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
