# Local stack overrides (docker/compose.local.yaml + scripts/local/*). scripts/local/up.sh copies this file
# to docker/.env.local (gitignored) on first run and exports it before starting the backend, so anything set
# there overrides the defaults in src/main/resources/application-local.yaml.
#
# Every value is a throwaway local-development value; none of them exists outside this stack.
# See docs/guides/local-environment.md for the full variable list.

# Backend (bootRun, Spring profile `local`, which also activates `dev`)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=38080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55432/elimika
SPRING_DATASOURCE_USERNAME=elimika
SPRING_DATASOURCE_PASSWORD=elimika-local

# Keycloak realm elimika-local (docker/keycloak/elimika-local-realm.json)
APP_KEYCLOAK_SERVERURL=http://localhost:58080
APP_KEYCLOAK_REALM=elimika-local
APP_KEYCLOAK_ADMIN_CLIENTID=elimika-backend
APP_KEYCLOAK_ADMIN_CLIENTSECRET=elimika-local-backend-secret

# Meilisearch: on this stack only, the API uses the master key directly.
SEARCH_MEILISEARCH_HOST=http://localhost:57700
SEARCH_MEILISEARCH_API_KEY=elimika-local-meili-master-key

# Scripts (token.sh, seed.sh, smoke.sh)
API_URL=http://localhost:38080
KEYCLOAK_URL=http://localhost:58080
KEYCLOAK_UI_CLIENT_ID=elimika-ui
KEYCLOAK_UI_CLIENT_SECRET=elimika-local-ui-secret
QA_PASSWORD=Passw0rd!
