# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:<DB_PORT>/<DB_NAME>
SPRING_DATASOURCE_USERNAME=<DB_USERNAME>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# OAuth/JWT Configuration
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=<OAUTH_ISSUER_URI>
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=<OAUTH_JWK_SET_URI>

# Keycloak Configuration
APP_KEYCLOAK_REALM=<KEYCLOAK_REALM>
APP_KEYCLOAK_SERVERURL=<KEYCLOAK_SERVERURL>
APP_KEYCLOAK_ADMIN_CLIENTID=<KEYCLOAK_ADMIN_CLIENTID>
APP_KEYCLOAK_ADMIN_CLIENTSECRET=<KEYCLOAK_ADMIN_CLIENTSECRET>

# One-time platform admin bootstrap (disabled by default)
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_FIRST_NAME=
APP_BOOTSTRAP_ADMIN_MIDDLE_NAME=
APP_BOOTSTRAP_ADMIN_LAST_NAME=
APP_BOOTSTRAP_ADMIN_PHONE_NUMBER=

# Encryption Configuration
ENCRYPTION_SECRET_KEY=<ENCRYPTION_SECRET_KEY>
ENCRYPTION_SALT=<ENCRYPTION_SALT>

# Mail Server Configuration
MAIL_SERVER=<MAIL_SERVER>
MAIL_SERVER_PORT=<MAIL_SERVER_PORT>
MAIL_USERNAME=<YOUR_EMAIL@GMAIL.COM>
MAIL_PASSWORD=<YOUR_APP_PASSWORD>

# Storage Configuration - Updated to use container path
STORAGE_PATH=/app/storage

# Logging Configuration
LOGGING_FILE_NAME=/app/logs/elimika.log

# Spring Profile Configuration
SPRING_PROFILES_ACTIVE=dev

# API Documentation Access
# Normally left unset: the SPRING_PROFILES_ACTIVE above decides. Under `dev` the specification and
# Swagger UI are served anonymously (application-dev.yaml), which is what lets the frontend
# regenerate its client from staging; under `prod` they are restricted to platform administrators.
# Set APP_API_DOCS_PUBLIC=true or =false only to override that for a specific host — note it wins
# over the profile, so an explicit value here will silence the profile default.
# See docs/api-documentation-access.md.

KC_PROD_SERVER_URL=<KC_PROD_SERVER_URL>
